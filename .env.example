# ===== Docker 网页打印服务 (.env) =====
# 复制为 .env 后按需修改，docker compose 会自动读取

# 初始管理员账号（仅首次初始化用户库时生效，之后请在网页“用户管理”中维护）
AUTH_USER=admin
AUTH_PASS=admin123
# 会话密钥，务必改成随机字符串
SESSION_SECRET=please-change-this-secret
# 登录会话有效小时数
SESSION_HOURS=12

# 未登录（游客）打印配额：每 ANON_WINDOW_HOURS 小时最多 ANON_PRINT_LIMIT 次
ANON_PRINT_LIMIT=5
ANON_WINDOW_HOURS=3

# 登录爆破防护：窗口内最多失败次数
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=15

# 反向代理层数（本机直连可设 0；Cloudflare Tunnel 场景保持 1）
TRUST_PROXY=1

# 宿主机打印 Agent 地址
HOST_PRINT_API=http://host.docker.internal:8081
# 与宿主机 Agent 约定的令牌（两边保持一致，留空则不校验）
HOST_PRINT_TOKEN=

# 最大上传文件大小（字节），默认 20MB
MAX_FILE_SIZE=20971520
