{
  "name": "web-print-tray",
  "version": "1.0.0",
  "private": true,
  "description": "Windows 打印助手：内置本地打印服务，托盘常驻，可打包为 exe。",
  "author": "miralexand",
  "license": "MulanPSL-2.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable",
    "pack": "electron-builder --win --dir"
  },
  "dependencies": {
    "express": "^4.21.2",
    "multer": "^2.0.1",
    "pdf-to-printer": "^5.6.0"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.miralexand.webprint.tray",
    "productName": "WebPrintTray",
    "copyright": "Copyright (c) 2026 miralexand",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "build/**/*"
    ],
    "asarUnpack": [
      "build/**/*",
      "**/node_modules/pdf-to-printer/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WebPrint 打印助手"
    }
  }
}
